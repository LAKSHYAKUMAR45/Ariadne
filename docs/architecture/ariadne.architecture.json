  "cards": [
    {
      "dot": "cyan",
      "title": "Local-first",
      "items": [
        "CLI, MCP server, and VS Code extension use the shared core.",
        "Each workspace's SQLite database remains its source of truth."
      ]
    },
    {
      "dot": "violet",
      "title": "Registry is an index",
      "items": [
        "The machine-wide registry helps discover tasks across workspaces.",
        "It is not a copy of task history or a sync mechanism."
      ]
    },
    {
      "dot": "amber",
      "title": "Sync is optional",
      "items": [
        "Push/pull goes to a separately operated HTTP service.",
        "MCP and VS Code sync commands delegate to the CLI.",
        "PostgreSQL stores the remote shared data; local use does not depend on it."
      ]
    }
  ]
