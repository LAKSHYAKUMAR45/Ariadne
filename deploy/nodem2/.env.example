# Names only — never commit values.
#
# Runtime values live in root-owned 0600 files on the host:
#   /etc/ariadne/compose.env      (Compose interpolation + postgres secrets)
#   /etc/ariadne/sync-server.env  (sync-server / migrate process environment)
#
# /etc/ariadne/compose.env
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_MAINTENANCE_PORT=
SYNC_SERVER_IMAGE=
ARIADNE_PROXY_BIND_ADDRESS=
ARIADNE_PROXY_PORT=
#
# /etc/ariadne/sync-server.env
DATABASE_URL=
SYNC_SERVER_JWT_SECRET=
ADMIN_PUBLIC_ORIGIN=
ARIADNE_SSO_SHARED_SECRET=
