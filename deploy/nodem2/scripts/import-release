#!/bin/sh
# Imports one directly copied, reviewed Ariadne release into the fixed
# deployment worktree. This script only stages Git objects and source files; it
# never changes Docker or systemd state.
set -eu
umask 077

ARIADNE_LOG_TAG=ariadne-import-release
ARIADNE_PRODUCTION_ROOT=/opt/ariadne
ARIADNE_INSTALLED_LIB_DIR=/usr/local/lib/ariadne
ARIADNE_TRUSTED_REF=refs/ariadne/deploy
ARIADNE_STAGE_DIR=

log() {
    printf '[%s] %s\n' "$ARIADNE_LOG_TAG" "$1"
}

fail() {
    printf '[%s] error: %s\n' "$ARIADNE_LOG_TAG" "$1" >&2
    exit 1
}

cleanup() {
    if [ -n "$ARIADNE_STAGE_DIR" ]; then
        case "$ARIADNE_STAGE_DIR" in
            "$ARIADNE_DEPLOY_ROOT"/.release-import.*)
                rm -rf -- "$ARIADNE_STAGE_DIR"
                ;;
            *)
                printf '[%s] error: refusing to clean unexpected staging path\n' "$ARIADNE_LOG_TAG" >&2
                ;;
        esac
    fi
}

if [ "${ARIADNE_IMPORT_SELFTEST:-}" = "1" ]; then
    [ "$(id -u)" != "0" ] ||
        fail "ARIADNE_IMPORT_SELFTEST=1 is refused when running as root"
    case "$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)" in
        "$ARIADNE_PRODUCTION_ROOT" | "$ARIADNE_PRODUCTION_ROOT"/* | "$ARIADNE_INSTALLED_LIB_DIR" | "$ARIADNE_INSTALLED_LIB_DIR"/*)
            fail "ARIADNE_IMPORT_SELFTEST=1 is refused for installed copies"
            ;;
    esac
    [ -n "${ARIADNE_IMPORT_PREFIX:-}" ] ||
        fail "ARIADNE_IMPORT_SELFTEST=1 requires ARIADNE_IMPORT_PREFIX"
    case "$ARIADNE_IMPORT_PREFIX" in
        /bin* | /boot* | /etc* | /lib* | /opt* | /root* | /run* | /sbin* | /srv* | /usr* | /var*)
            fail "ARIADNE_IMPORT_PREFIX must not name a system directory"
            ;;
        /*/*) ;;
        *) fail "ARIADNE_IMPORT_PREFIX must be an absolute path below the filesystem root" ;;
    esac
    [ -d "$ARIADNE_IMPORT_PREFIX" ] ||
        fail "ARIADNE_IMPORT_PREFIX must be an existing directory"
    ARIADNE_PREFIX=$ARIADNE_IMPORT_PREFIX
    ARIADNE_OWNER_UID=${ARIADNE_IMPORT_OWNER_UID:-0}
elif [ -n "${ARIADNE_IMPORT_SELFTEST:-}" ]; then
    fail "ARIADNE_IMPORT_SELFTEST must not be set for a privileged invocation"
else
    for ariadne_override in ARIADNE_IMPORT_PREFIX ARIADNE_IMPORT_OWNER_UID; do
        eval "ariadne_override_value=\${$ariadne_override:-}"
        [ -z "$ariadne_override_value" ] ||
            fail "$ariadne_override must not be set: release import uses fixed production paths"
    done
    unset ariadne_override ariadne_override_value
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export PATH
    ARIADNE_PREFIX=
    ARIADNE_OWNER_UID=0
fi

[ "$(id -u)" = "$ARIADNE_OWNER_UID" ] ||
    fail "import-release must run as the deployment owner (uid $ARIADNE_OWNER_UID)"
[ "$#" -eq 3 ] || fail "usage: import-release <40-character-commit-sha> <bundle> <archive>"

ARIADNE_REVISION=$1
ARIADNE_BUNDLE=$2
ARIADNE_ARCHIVE=$3
case "$ARIADNE_REVISION" in
    "" | *[!0-9a-f]*) fail "revision must be a full 40-character lowercase hex commit sha" ;;
esac
[ "${#ARIADNE_REVISION}" -eq 40 ] ||
    fail "revision must be a full 40-character lowercase hex commit sha"
case "$ARIADNE_BUNDLE" in
    /*) ;;
    *) fail "release bundle path must be absolute" ;;
esac
case "$ARIADNE_ARCHIVE" in
    /*) ;;
    *) fail "release archive path must be absolute" ;;
esac

ARIADNE_DEPLOY_ROOT="$ARIADNE_PREFIX$ARIADNE_PRODUCTION_ROOT"
ARIADNE_WORKTREE="$ARIADNE_DEPLOY_ROOT/worktree"
[ -d "$ARIADNE_WORKTREE" ] || fail "deployment worktree is missing: $ARIADNE_WORKTREE"
[ -d "$ARIADNE_WORKTREE/.git" ] || [ -f "$ARIADNE_WORKTREE/.git" ] ||
    fail "deployment worktree is not a Git repository"

require_safe_file() {
    [ -f "$1" ] || fail "$2 is missing or is not a regular file"
    [ ! -L "$1" ] || fail "$2 must not be a symbolic link"
    ariadne_file_uid=$(stat -c '%u' "$1") || fail "cannot inspect $2 ownership"
    [ "$ariadne_file_uid" = "$ARIADNE_OWNER_UID" ] ||
        fail "$2 is not owned by uid $ARIADNE_OWNER_UID"
    ariadne_file_mode=$(stat -c '%a' "$1") || fail "cannot inspect $2 mode"
    [ "$((0$ariadne_file_mode & 022))" -eq 0 ] ||
        fail "$2 must not be group- or world-writable"
    unset ariadne_file_uid ariadne_file_mode
}

require_safe_directory() {
    [ -d "$1" ] || fail "$2 is missing"
    [ ! -L "$1" ] || fail "$2 must not be a symbolic link"
    ariadne_dir_uid=$(stat -c '%u' "$1") || fail "cannot inspect $2 ownership"
    [ "$ariadne_dir_uid" = "$ARIADNE_OWNER_UID" ] ||
        fail "$2 is not owned by uid $ARIADNE_OWNER_UID"
    ariadne_dir_mode=$(stat -c '%a' "$1") || fail "cannot inspect $2 mode"
    [ "$((0$ariadne_dir_mode & 022))" -eq 0 ] ||
        fail "$2 must not be group- or world-writable"
    unset ariadne_dir_uid ariadne_dir_mode
}

require_safe_directory "$ARIADNE_DEPLOY_ROOT" "deployment root"
require_safe_directory "$ARIADNE_WORKTREE" "deployment worktree"
require_safe_file "$ARIADNE_BUNDLE" "release bundle"
require_safe_file "$ARIADNE_ARCHIVE" "release archive"

[ -z "$(git -C "$ARIADNE_WORKTREE" status --porcelain --untracked-files=all)" ] ||
    fail "deployment worktree is dirty; refusing to import over local files"

git -C "$ARIADNE_WORKTREE" bundle verify "$ARIADNE_BUNDLE" >/dev/null 2>&1 ||
    fail "release bundle is invalid or has unavailable prerequisites"
if sed -n '2,/^$/p' "$ARIADNE_BUNDLE" | grep -Eq '^-[0-9a-f]{40} '; then
    fail "release bundle must contain complete history without prerequisites"
fi
git -C "$ARIADNE_WORKTREE" bundle list-heads "$ARIADNE_BUNDLE" |
    awk -v revision="$ARIADNE_REVISION" '$1 == revision { found=1 } END { exit(found ? 0 : 1) }' ||
    fail "release bundle does not advertise the requested revision"

ARIADNE_ARCHIVE_REVISION=$(git get-tar-commit-id <"$ARIADNE_ARCHIVE" 2>/dev/null || true)
[ "$ARIADNE_ARCHIVE_REVISION" = "$ARIADNE_REVISION" ] ||
    fail "release archive does not identify the requested revision"
tar -tf "$ARIADNE_ARCHIVE" >/dev/null 2>&1 || fail "release archive is invalid"

ARIADNE_STAGE_DIR=$(mktemp -d "$ARIADNE_DEPLOY_ROOT/.release-import.XXXXXX") ||
    fail "failed to create release staging directory"
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
ARIADNE_STAGE_FILES="$ARIADNE_STAGE_DIR/files"
ARIADNE_EXPECTED_FILES="$ARIADNE_STAGE_DIR/expected"
ARIADNE_ARCHIVE_LIST="$ARIADNE_STAGE_DIR/archive.list"
ARIADNE_ARCHIVE_VERBOSE="$ARIADNE_STAGE_DIR/archive.verbose"
ARIADNE_STAGE_MANIFEST="$ARIADNE_STAGE_DIR/stage.manifest"
ARIADNE_EXPECTED_MANIFEST="$ARIADNE_STAGE_DIR/expected.manifest"
mkdir "$ARIADNE_STAGE_FILES" "$ARIADNE_EXPECTED_FILES" ||
    fail "failed to create staged file directories"

tar -tf "$ARIADNE_ARCHIVE" >"$ARIADNE_ARCHIVE_LIST" ||
    fail "failed to inspect release archive paths"
while IFS= read -r ariadne_entry; do
    case "$ariadne_entry" in
        "" | /* | .. | ../* | */.. | */../* | .git | .git/* | */.git | */.git/*)
            fail "release archive contains an unsafe path"
            ;;
    esac
done <"$ARIADNE_ARCHIVE_LIST"
unset ariadne_entry

tar -tvf "$ARIADNE_ARCHIVE" >"$ARIADNE_ARCHIVE_VERBOSE" ||
    fail "failed to inspect release archive entry types"
while IFS= read -r ariadne_entry; do
    ariadne_type=$(printf '%s' "$ariadne_entry" | cut -c1)
    case "$ariadne_type" in
        - | d) ;;
        *) fail "release archive contains a link or unsupported entry type" ;;
    esac
done <"$ARIADNE_ARCHIVE_VERBOSE"
unset ariadne_entry ariadne_type

tar -xf "$ARIADNE_ARCHIVE" -C "$ARIADNE_STAGE_FILES" --no-same-owner --same-permissions ||
    fail "failed to extract release archive"

git -C "$ARIADNE_WORKTREE" bundle unbundle "$ARIADNE_BUNDLE" >/dev/null ||
    fail "failed to import release bundle objects"
git -C "$ARIADNE_WORKTREE" cat-file -e "$ARIADNE_REVISION^{commit}" 2>/dev/null ||
    fail "requested revision is not a commit after bundle import"

git -C "$ARIADNE_WORKTREE" archive --format=tar "$ARIADNE_REVISION" |
    tar -xf - -C "$ARIADNE_EXPECTED_FILES" --no-same-owner --same-permissions ||
    fail "failed to materialize the requested revision for comparison"
diff -qr --no-dereference "$ARIADNE_EXPECTED_FILES" "$ARIADNE_STAGE_FILES" >/dev/null ||
    fail "release archive content does not exactly match the requested revision"
find "$ARIADNE_STAGE_FILES" -mindepth 1 -printf '%P\t%y\t%m\n' | sort >"$ARIADNE_STAGE_MANIFEST" ||
    fail "failed to record release archive metadata"
find "$ARIADNE_EXPECTED_FILES" -mindepth 1 -printf '%P\t%y\t%m\n' |
    sort >"$ARIADNE_EXPECTED_MANIFEST" ||
    fail "failed to record requested revision metadata"
cmp -s "$ARIADNE_STAGE_MANIFEST" "$ARIADNE_EXPECTED_MANIFEST" ||
    fail "release archive modes do not exactly match the requested revision"

rsync --archive --exclude=/.git "$ARIADNE_STAGE_FILES/" "$ARIADNE_WORKTREE/" ||
    fail "failed to synchronize reviewed release files"
git -C "$ARIADNE_WORKTREE" checkout --detach --force "$ARIADNE_REVISION" >/dev/null 2>&1 ||
    fail "failed to set the deployment worktree revision"
[ "$(git -C "$ARIADNE_WORKTREE" rev-parse HEAD)" = "$ARIADNE_REVISION" ] ||
    fail "deployment worktree HEAD does not match the requested revision"
[ -z "$(git -C "$ARIADNE_WORKTREE" status --porcelain --untracked-files=all)" ] ||
    fail "deployment worktree does not exactly match the requested revision"

git -C "$ARIADNE_WORKTREE" update-ref "$ARIADNE_TRUSTED_REF" "$ARIADNE_REVISION" ||
    fail "failed to update the fixed deployment trust ref"
[ "$(git -C "$ARIADNE_WORKTREE" rev-parse "$ARIADNE_TRUSTED_REF")" = "$ARIADNE_REVISION" ] ||
    fail "fixed deployment trust ref does not match the imported revision"

log "imported reviewed revision $ARIADNE_REVISION into $ARIADNE_WORKTREE"
