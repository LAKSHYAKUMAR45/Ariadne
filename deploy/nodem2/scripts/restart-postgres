#!/bin/sh
# Restarts only the postgres service of the tracked nodem2 Compose project.
set -eu
umask 077

SCRIPT_DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=deploy/nodem2/scripts/lib-common
. "$SCRIPT_DIR/lib-common"

[ "$#" -eq 0 ] || fail "usage: restart-postgres (takes no arguments)"

require_file "$ARIADNE_COMPOSE_ENV_FILE"
require_file "$ARIADNE_COMPOSE_FILE"

ariadne_compose restart postgres || fail "failed to restart postgres"

# Postgres first: the application cannot report healthy until the database it
# depends on is accepting connections again.
log "waiting for postgres to accept connections"
ariadne_wait_for_postgres ||
    fail "postgres did not accept connections within $ARIADNE_HEALTH_ATTEMPTS attempts after the restart"

log "waiting for sync-server to become healthy"
ariadne_wait_for_health ||
    fail "sync-server did not become healthy within $ARIADNE_HEALTH_ATTEMPTS attempts after the postgres restart"

log "postgres and sync-server are healthy"
