# Shared fixed configuration for the tracked nodem2 deployment scripts.
# Sourced by ./deploy, ./restart-sync-server, ./restart-postgres, ./backup,
# ./restore-backup, ./verify-backup, and ./prune-backups.
# shellcheck shell=sh
# shellcheck disable=SC2034  # values are consumed by the sourcing scripts

# Fixed by this file, never by the environment; a sourcing script may narrow it
# afterwards so journald entries identify the operation.
ARIADNE_LOG_TAG=ariadne-deploy

log() {
    printf '[%s] %s\n' "$ARIADNE_LOG_TAG" "$1"
}

fail() {
    printf '[%s] error: %s\n' "$ARIADNE_LOG_TAG" "$1" >&2
    exit 1
}

# Production paths are fixed constants that the environment can never redirect.
# The tracked contract tests in deploy/nodem2/test/deploy.test.ts exercise these
# same scripts through ARIADNE_DEPLOY_SELFTEST=1, which is refused whenever it
# could affect a real deployment: as root, or for the copy installed under
# /opt/ariadne. Any production invocation carrying an override variable fails
# before Docker runs instead of silently ignoring it.
ARIADNE_PRODUCTION_ROOT=/opt/ariadne
ARIADNE_PRODUCTION_SCRIPTS_DIR="$ARIADNE_PRODUCTION_ROOT/worktree/deploy/nodem2/scripts"

if [ "${ARIADNE_DEPLOY_SELFTEST:-}" = "1" ]; then
    if [ "$(id -u)" = "0" ]; then
        fail "ARIADNE_DEPLOY_SELFTEST=1 is refused when running as root; deployments always use the fixed paths"
    fi
    case "${SCRIPT_DIR:-}" in
        "$ARIADNE_PRODUCTION_ROOT" | "$ARIADNE_PRODUCTION_ROOT"/*)
            fail "ARIADNE_DEPLOY_SELFTEST=1 is refused for scripts installed under $ARIADNE_PRODUCTION_SCRIPTS_DIR"
            ;;
    esac

    [ -n "${ARIADNE_DEPLOY_ROOT:-}" ] ||
        fail "ARIADNE_DEPLOY_SELFTEST=1 requires ARIADNE_DEPLOY_ROOT"
    [ -n "${ARIADNE_DEPLOY_ETC:-}" ] ||
        fail "ARIADNE_DEPLOY_SELFTEST=1 requires ARIADNE_DEPLOY_ETC"
    [ -n "${ARIADNE_DEPLOY_STATE:-}" ] ||
        fail "ARIADNE_DEPLOY_SELFTEST=1 requires ARIADNE_DEPLOY_STATE"

    ARIADNE_ETC_DIR="$ARIADNE_DEPLOY_ETC"
    ARIADNE_STATE_DIR="$ARIADNE_DEPLOY_STATE"
    ARIADNE_BACKUP_DIR="${ARIADNE_DEPLOY_BACKUP_DIR:-$ARIADNE_DEPLOY_STATE/backups}"
    ARIADNE_HEALTH_ATTEMPTS="${ARIADNE_DEPLOY_HEALTH_ATTEMPTS:-30}"
    ARIADNE_HEALTH_INTERVAL="${ARIADNE_DEPLOY_HEALTH_INTERVAL:-2}"
elif [ -n "${ARIADNE_DEPLOY_SELFTEST:-}" ]; then
    fail "ARIADNE_DEPLOY_SELFTEST must not be set for a deployment invocation"
else
    for ariadne_override in ARIADNE_DEPLOY_ROOT ARIADNE_DEPLOY_ETC ARIADNE_DEPLOY_STATE \
        ARIADNE_DEPLOY_BACKUP_DIR ARIADNE_DEPLOY_HEALTH_ATTEMPTS ARIADNE_DEPLOY_HEALTH_INTERVAL; do
        eval "ariadne_override_value=\${$ariadne_override:-}"
        [ -z "$ariadne_override_value" ] ||
            fail "$ariadne_override must not be set: deployments use the fixed production paths"
    done
    unset ariadne_override ariadne_override_value

    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export PATH
    ARIADNE_DEPLOY_ROOT="$ARIADNE_PRODUCTION_ROOT"
    ARIADNE_ETC_DIR=/etc/ariadne
    ARIADNE_STATE_DIR=/var/lib/ariadne/deploy
    ARIADNE_BACKUP_DIR=/var/backups/ariadne
    ARIADNE_HEALTH_ATTEMPTS=30
    ARIADNE_HEALTH_INTERVAL=2
fi

ARIADNE_COMPOSE_PROJECT=ariadne-nodem2
ARIADNE_WORKTREE="$ARIADNE_DEPLOY_ROOT/worktree"
ARIADNE_COMPOSE_FILE="$ARIADNE_WORKTREE/deploy/nodem2/compose.yaml"
ARIADNE_COMPOSE_ENV_FILE="$ARIADNE_ETC_DIR/compose.env"
ARIADNE_SERVER_ENV_FILE="$ARIADNE_ETC_DIR/sync-server.env"
ARIADNE_KEYS_DIR="$ARIADNE_ETC_DIR/keys"
ARIADNE_IMAGE_REPO=ariadne-sync-server
ARIADNE_CURRENT_TAG="$ARIADNE_IMAGE_REPO:current"
ARIADNE_HEALTH_URL="http://127.0.0.1:4300/healthz"

# The only source a deployable revision may come from.
ARIADNE_TRUSTED_REMOTE=origin
ARIADNE_TRUSTED_BRANCH=main
ARIADNE_TRUSTED_REF="refs/remotes/$ARIADNE_TRUSTED_REMOTE/$ARIADNE_TRUSTED_BRANCH"

# Every Compose invocation uses the same fixed file, project, and env file.
ariadne_compose() {
    docker compose \
        -f "$ARIADNE_COMPOSE_FILE" \
        -p "$ARIADNE_COMPOSE_PROJECT" \
        --env-file "$ARIADNE_COMPOSE_ENV_FILE" \
        "$@"
}

require_file() {
    [ -f "$1" ] || fail "required file missing: $1"
}

# ---------------------------------------------------------------------------
# Readiness
#
# Every operation that restarts or replaces a service must observe the service
# coming back before it exits: the operator reports an operation terminal as
# soon as its command returns, and the web tier's callback endpoint lives
# behind exactly this health endpoint. Returning early would report success
# while the deployment is still unavailable — and, when the sync-server itself
# was restarted, would race the very endpoint the result is reported to.
#
# Both waits are bounded by the fixed ARIADNE_HEALTH_ATTEMPTS /
# ARIADNE_HEALTH_INTERVAL configuration, so an unhealthy service fails the
# operation instead of hanging until the operator's execution timeout.
# ---------------------------------------------------------------------------

ariadne_wait_for_health() {
    ariadne_health_attempt=1
    while [ "$ariadne_health_attempt" -le "$ARIADNE_HEALTH_ATTEMPTS" ]; do
        if curl -fsS --max-time 5 -o /dev/null "$ARIADNE_HEALTH_URL"; then
            unset ariadne_health_attempt
            return 0
        fi
        ariadne_health_attempt=$((ariadne_health_attempt + 1))
        if [ "$ariadne_health_attempt" -le "$ARIADNE_HEALTH_ATTEMPTS" ] &&
            [ "$ARIADNE_HEALTH_INTERVAL" -gt 0 ]; then
            sleep "$ARIADNE_HEALTH_INTERVAL"
        fi
    done
    unset ariadne_health_attempt
    return 1
}

ariadne_wait_for_postgres() {
    ariadne_pg_attempt=1
    while [ "$ariadne_pg_attempt" -le "$ARIADNE_HEALTH_ATTEMPTS" ]; do
        if ariadne_compose exec -T postgres pg_isready \
            --username "$ARIADNE_DB_USER" --dbname "$ARIADNE_DB_NAME" >/dev/null 2>&1; then
            unset ariadne_pg_attempt
            return 0
        fi
        ariadne_pg_attempt=$((ariadne_pg_attempt + 1))
        if [ "$ariadne_pg_attempt" -le "$ARIADNE_HEALTH_ATTEMPTS" ] &&
            [ "$ARIADNE_HEALTH_INTERVAL" -gt 0 ]; then
            sleep "$ARIADNE_HEALTH_INTERVAL"
        fi
    done
    unset ariadne_pg_attempt
    return 1
}

require_deployment_inputs() {
    require_file "$ARIADNE_COMPOSE_ENV_FILE"
    require_file "$ARIADNE_SERVER_ENV_FILE"
    require_file "$ARIADNE_KEYS_DIR/active-key-id"
    require_file "$ARIADNE_COMPOSE_FILE"

    key_count=$(find "$ARIADNE_KEYS_DIR" -maxdepth 1 -type f -name '*.key' 2>/dev/null | wc -l)
    [ "$key_count" -ge 1 ] || fail "no encryption key files found in $ARIADNE_KEYS_DIR"
    unset key_count
}

# ---------------------------------------------------------------------------
# Backup contract
#
# Backups live only in the fixed root above. A backup is a triplet published in
# a fixed order (`.sha256`, then `.json`, then `.dump`), so the presence of a
# `.dump` always implies its sidecars exist. The encryption key directory is
# never an input: only key *identifiers* (filenames) are recorded so an
# operator can tell which keys a restored database still needs.
# ---------------------------------------------------------------------------

# Must match the Compose defaults for POSTGRES_DB / POSTGRES_USER.
ARIADNE_DB_NAME=ariadne_sync
ARIADNE_DB_USER=ariadne
ARIADNE_MAINTENANCE_DB=postgres
ARIADNE_BACKUP_RETENTION_DAYS=30
ARIADNE_BACKUP_TMP_RETENTION_DAYS=1
ARIADNE_RESTORE_COMMAND=/usr/local/lib/ariadne/restore-backup
ARIADNE_RESTART_SYNC_SERVER_COMMAND=/usr/local/lib/ariadne/restart-sync-server

# Basename of the most recent backup this process published, used by callers to
# report the safety backup and to discard partial output.
ARIADNE_CREATED_BACKUP=""
ARIADNE_PARTIAL_BACKUP=""

ariadne_require_backup_inputs() {
    require_file "$ARIADNE_COMPOSE_ENV_FILE"
    require_file "$ARIADNE_COMPOSE_FILE"
}

ariadne_backup_dir() {
    mkdir -p "$ARIADNE_BACKUP_DIR" || fail "failed to create $ARIADNE_BACKUP_DIR"
    chmod 700 "$ARIADNE_BACKUP_DIR" || fail "failed to secure $ARIADNE_BACKUP_DIR"
}

# Accepts exactly ariadne-YYYYMMDDTHHMMSSZ. Anything else - a path, a sidecar,
# a temporary file - is refused before any filesystem or database access.
ariadne_validate_stamp() {
    case "$1" in
        ????????T??????Z) ;;
        *) fail "invalid backup timestamp" ;;
    esac
    case "$1" in
        *[!0-9TZ]*) fail "invalid backup timestamp" ;;
    esac
}

# Validates a caller-supplied basename and sets ARIADNE_BACKUP_BASE (no
# extension). Never accepts separators, so the name can only resolve inside the
# fixed backup root.
ariadne_validate_backup_name() {
    ariadne_backup_name=$1
    case "$ariadne_backup_name" in
        "" | . | ..) fail "backup name must be a validated basename" ;;
        */* | *\\*) fail "backup name must be a basename without path separators" ;;
        ariadne-*.dump) ;;
        *) fail "backup name must look like ariadne-YYYYMMDDTHHMMSSZ.dump" ;;
    esac

    ariadne_backup_stamp=${ariadne_backup_name#ariadne-}
    ariadne_backup_stamp=${ariadne_backup_stamp%.dump}
    ariadne_validate_stamp "$ariadne_backup_stamp"
    ARIADNE_BACKUP_BASE="ariadne-$ariadne_backup_stamp"
    unset ariadne_backup_name ariadne_backup_stamp
}

ariadne_require_backup_set() {
    require_file "$ARIADNE_BACKUP_DIR/$1.dump"
    require_file "$ARIADNE_BACKUP_DIR/$1.sha256"
    require_file "$ARIADNE_BACKUP_DIR/$1.json"
}

# Prints the SHA-256 of a file. Reads from stdin so the digest never depends on
# how the path is spelled.
ariadne_sha256_of() {
    ariadne_sha_line=$(sha256sum <"$1") || return 1
    ariadne_sha_value=${ariadne_sha_line%% *}
    case "$ariadne_sha_value" in
        *[!0-9a-f]* | "") return 1 ;;
    esac
    [ "${#ariadne_sha_value}" -eq 64 ] || return 1
    printf '%s\n' "$ariadne_sha_value"
    unset ariadne_sha_line ariadne_sha_value
}

# Recomputes the checksum of a published dump and compares it with its sidecar.
ariadne_checksum_matches() {
    ariadne_expected=$(cut -d' ' -f1 <"$ARIADNE_BACKUP_DIR/$1.sha256") || return 1
    ariadne_actual=$(ariadne_sha256_of "$ARIADNE_BACKUP_DIR/$1.dump") || return 1
    [ -n "$ariadne_expected" ] || return 1
    [ "$ariadne_expected" = "$ariadne_actual" ] || return 1
    unset ariadne_expected ariadne_actual
}

# Reads the archive table of contents. A dump that cannot be listed is never
# used to mutate anything.
ariadne_dump_is_readable() {
    ariadne_compose exec -T postgres pg_restore --list <"$1" >/dev/null
}

ariadne_psql() {
    ariadne_compose exec -T postgres psql \
        --username "$ARIADNE_DB_USER" \
        --dbname "$1" \
        --no-psqlrc --quiet --tuples-only --no-align \
        --set ON_ERROR_STOP=1 \
        --command "$2" </dev/null
}

# Sanitises any value taken from the database before it reaches metadata so a
# hostile string can never be embedded in JSON.
ariadne_safe_token() {
    case "${1:-}" in
        "" | *[!A-Za-z0-9._:-]*) printf 'unknown\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Key identifiers only: filenames are listed, file contents are never read.
ariadne_key_ids_json() {
    ariadne_ids=""
    for ariadne_key_file in "$ARIADNE_KEYS_DIR"/*.key; do
        [ -f "$ariadne_key_file" ] || continue
        ariadne_key_id=$(basename "$ariadne_key_file" .key)
        case "$ariadne_key_id" in
            *[!A-Za-z0-9._-]*) continue ;;
        esac
        if [ -z "$ariadne_ids" ]; then
            ariadne_ids="\"$ariadne_key_id\""
        else
            ariadne_ids="$ariadne_ids,\"$ariadne_key_id\""
        fi
    done
    printf '[%s]\n' "$ariadne_ids"
    unset ariadne_ids ariadne_key_file ariadne_key_id
}

ariadne_active_key_id() {
    if [ -f "$ARIADNE_KEYS_DIR/active-key-id" ]; then
        ariadne_active=$(head -n 1 "$ARIADNE_KEYS_DIR/active-key-id" | tr -d ' \t\r\n')
        ariadne_safe_token "$ariadne_active"
        unset ariadne_active
    else
        printf 'unknown\n'
    fi
}

# Removes anything a failed or interrupted backup may have left behind. A
# sidecar is only ever kept once its dump has been published.
ariadne_discard_partial() {
    [ -n "${1:-}" ] || return 0
    rm -f "$ARIADNE_BACKUP_DIR/$1.dump.tmp" \
        "$ARIADNE_BACKUP_DIR/$1.sha256.tmp" \
        "$ARIADNE_BACKUP_DIR/$1.json.tmp"
    if [ ! -f "$ARIADNE_BACKUP_DIR/$1.dump" ]; then
        rm -f "$ARIADNE_BACKUP_DIR/$1.sha256" "$ARIADNE_BACKUP_DIR/$1.json"
    fi
    return 0
}

ariadne_fail_partial() {
    ariadne_discard_partial "$ARIADNE_PARTIAL_BACKUP"
    ARIADNE_PARTIAL_BACKUP=""
    fail "$1"
}

# Creates one verified backup triplet and sets ARIADNE_CREATED_BACKUP to its
# basename. Every intermediate file is written as `.tmp` and renamed only after
# the dump has been listed, hashed, and described.
ariadne_create_backup() {
    ariadne_backup_dir

    ariadne_stamp=$(date -u +%Y%m%dT%H%M%SZ) || fail "failed to read the clock"
    ariadne_validate_stamp "$ariadne_stamp"
    ariadne_base="ariadne-$ariadne_stamp"
    [ ! -e "$ARIADNE_BACKUP_DIR/$ariadne_base.dump" ] ||
        fail "a backup named $ariadne_base.dump already exists"

    ARIADNE_PARTIAL_BACKUP="$ariadne_base"
    ariadne_tmp_dump="$ARIADNE_BACKUP_DIR/$ariadne_base.dump.tmp"
    ariadne_tmp_sum="$ARIADNE_BACKUP_DIR/$ariadne_base.sha256.tmp"
    ariadne_tmp_meta="$ARIADNE_BACKUP_DIR/$ariadne_base.json.tmp"
    rm -f "$ariadne_tmp_dump" "$ariadne_tmp_sum" "$ariadne_tmp_meta"

    log "dumping $ARIADNE_DB_NAME to $ariadne_base.dump"
    ariadne_compose exec -T postgres pg_dump \
        --format=custom --no-owner --no-acl \
        --username "$ARIADNE_DB_USER" --dbname "$ARIADNE_DB_NAME" \
        >"$ariadne_tmp_dump" ||
        ariadne_fail_partial "pg_dump failed; no backup was published"
    [ -s "$ariadne_tmp_dump" ] || ariadne_fail_partial "pg_dump produced an empty archive"

    ariadne_dump_is_readable "$ariadne_tmp_dump" ||
        ariadne_fail_partial "the new archive could not be listed; no backup was published"

    ariadne_hash=$(ariadne_sha256_of "$ariadne_tmp_dump") ||
        ariadne_fail_partial "failed to checksum the new archive"
    ariadne_bytes=$(wc -c <"$ariadne_tmp_dump" | tr -d ' ') ||
        ariadne_fail_partial "failed to measure the new archive"

    ariadne_image=$(docker image inspect --format '{{.Id}}' "$ARIADNE_CURRENT_TAG" 2>/dev/null || true)
    ariadne_image=$(ariadne_safe_token "$ariadne_image")
    ariadne_schema=$(ariadne_psql "$ARIADNE_DB_NAME" \
        'SELECT max(filename) FROM migrations_applied' 2>/dev/null || true)
    ariadne_schema=$(ariadne_safe_token "$(printf '%s' "$ariadne_schema" | tr -d ' \t\r\n')")

    printf '%s  %s\n' "$ariadne_hash" "$ariadne_base.dump" >"$ariadne_tmp_sum" ||
        ariadne_fail_partial "failed to write the checksum sidecar"

    printf '{"basename":"%s","timestamp":"%s","database":"%s","image":"%s","schemaVersion":"%s","dumpBytes":%s,"sha256":"%s","activeKeyId":"%s","keyIds":%s,"format":"custom"}\n' \
        "$ariadne_base.dump" \
        "$ariadne_stamp" \
        "$ARIADNE_DB_NAME" \
        "$ariadne_image" \
        "$ariadne_schema" \
        "$ariadne_bytes" \
        "$ariadne_hash" \
        "$(ariadne_active_key_id)" \
        "$(ariadne_key_ids_json)" \
        >"$ariadne_tmp_meta" ||
        ariadne_fail_partial "failed to write the metadata sidecar"

    chmod 600 "$ariadne_tmp_dump" "$ariadne_tmp_sum" "$ariadne_tmp_meta" ||
        ariadne_fail_partial "failed to secure the new backup files"
    sync "$ariadne_tmp_dump" "$ariadne_tmp_sum" "$ariadne_tmp_meta" 2>/dev/null || sync || true

    # Sidecars first: a visible `.dump` always has a complete set beside it.
    mv "$ariadne_tmp_sum" "$ARIADNE_BACKUP_DIR/$ariadne_base.sha256" ||
        ariadne_fail_partial "failed to publish the checksum sidecar"
    mv "$ariadne_tmp_meta" "$ARIADNE_BACKUP_DIR/$ariadne_base.json" ||
        ariadne_fail_partial "failed to publish the metadata sidecar"
    mv "$ariadne_tmp_dump" "$ARIADNE_BACKUP_DIR/$ariadne_base.dump" ||
        ariadne_fail_partial "failed to publish the archive"

    ARIADNE_PARTIAL_BACKUP=""
    ARIADNE_CREATED_BACKUP="$ariadne_base"
    log "published backup $ariadne_base.dump ($ariadne_bytes bytes)"
    unset ariadne_stamp ariadne_base ariadne_tmp_dump ariadne_tmp_sum ariadne_tmp_meta \
        ariadne_hash ariadne_bytes ariadne_image ariadne_schema
}

# ---------------------------------------------------------------------------
# Machine-readable backup result channel
#
# When the privileged operator sets ARIADNE_RESULT_FILE it receives one small
# JSON object describing *which* backup an operation acted on, so the web tier
# can record it without parsing free-form log output. Only facts already
# published in the backup's own sidecars are written: basename, the recorded
# checksum, the archive size, and the timestamp encoded in the name. Archive
# bytes, database contents, key material, and secrets are never included, and
# the optional message is reduced to a short run of safe characters.
#
# The script never decides the record's status: it reports identity only, and
# the operator derives the outcome from the exit code. That is what lets a
# failed verification or restore still be attributed to the right backup.
# ---------------------------------------------------------------------------

ARIADNE_RESULT_MESSAGE_MAX=200

ariadne_result_timestamp() {
    printf '%s-%s-%sT%s:%s:%sZ\n' \
        "$(printf '%s' "$1" | cut -c1-4)" \
        "$(printf '%s' "$1" | cut -c5-6)" \
        "$(printf '%s' "$1" | cut -c7-8)" \
        "$(printf '%s' "$1" | cut -c10-11)" \
        "$(printf '%s' "$1" | cut -c12-13)" \
        "$(printf '%s' "$1" | cut -c14-15)"
}

ariadne_write_backup_result() {
    [ -n "${ARIADNE_RESULT_FILE:-}" ] || return 0
    case "$ARIADNE_RESULT_FILE" in
        /*) ;;
        *) fail "ARIADNE_RESULT_FILE must be an absolute path" ;;
    esac

    ariadne_result_base=$1
    ariadne_result_stamp=${ariadne_result_base#ariadne-}
    ariadne_validate_stamp "$ariadne_result_stamp"

    ariadne_result_sum=$(cut -d' ' -f1 <"$ARIADNE_BACKUP_DIR/$ariadne_result_base.sha256") ||
        fail "failed to read the checksum sidecar of $ariadne_result_base.dump"
    case "$ariadne_result_sum" in
        *[!0-9a-f]* | "") fail "the checksum sidecar of $ariadne_result_base.dump is not a digest" ;;
    esac
    [ "${#ariadne_result_sum}" -eq 64 ] ||
        fail "the checksum sidecar of $ariadne_result_base.dump is not a digest"

    ariadne_result_bytes=$(wc -c <"$ARIADNE_BACKUP_DIR/$ariadne_result_base.dump" | tr -d ' ') ||
        fail "failed to measure $ariadne_result_base.dump"
    case "$ariadne_result_bytes" in
        "" | *[!0-9]*) fail "failed to measure $ariadne_result_base.dump" ;;
    esac

    ariadne_result_message=$(printf '%s' "${2:-}" |
        tr -cd 'A-Za-z0-9 ._:,;()-' |
        cut -c1-"$ARIADNE_RESULT_MESSAGE_MAX")

    ariadne_result_tmp="$ARIADNE_RESULT_FILE.tmp"
    rm -f "$ariadne_result_tmp"
    if [ -n "$ariadne_result_message" ]; then
        printf '{"filename":"%s","sha256":"%s","sizeBytes":%s,"createdAt":"%s","message":"%s"}\n' \
            "$ariadne_result_base.dump" \
            "$ariadne_result_sum" \
            "$ariadne_result_bytes" \
            "$(ariadne_result_timestamp "$ariadne_result_stamp")" \
            "$ariadne_result_message" \
            >"$ariadne_result_tmp" || fail "failed to write the operation result file"
    else
        printf '{"filename":"%s","sha256":"%s","sizeBytes":%s,"createdAt":"%s"}\n' \
            "$ariadne_result_base.dump" \
            "$ariadne_result_sum" \
            "$ariadne_result_bytes" \
            "$(ariadne_result_timestamp "$ariadne_result_stamp")" \
            >"$ariadne_result_tmp" || fail "failed to write the operation result file"
    fi

    chmod 600 "$ariadne_result_tmp" || fail "failed to secure the operation result file"
    mv "$ariadne_result_tmp" "$ARIADNE_RESULT_FILE" ||
        fail "failed to publish the operation result file"

    unset ariadne_result_base ariadne_result_stamp ariadne_result_sum ariadne_result_bytes \
        ariadne_result_message ariadne_result_tmp
    return 0
}

# Newest published backup basename, by validated filename only.
ariadne_newest_backup() {
    ariadne_newest=""
    for ariadne_candidate in "$ARIADNE_BACKUP_DIR"/ariadne-*.dump; do
        [ -f "$ariadne_candidate" ] || continue
        ariadne_candidate_base=$(basename "$ariadne_candidate" .dump)
        ariadne_candidate_stamp=${ariadne_candidate_base#ariadne-}
        case "$ariadne_candidate_stamp" in
            ????????T??????Z) ;;
            *) continue ;;
        esac
        case "$ariadne_candidate_stamp" in
            *[!0-9TZ]*) continue ;;
        esac
        [ -f "$ARIADNE_BACKUP_DIR/$ariadne_candidate_base.sha256" ] || continue
        [ -f "$ARIADNE_BACKUP_DIR/$ariadne_candidate_base.json" ] || continue
        # Every name has the same fixed width and differs only in its digits, so
        # the shell's sorted glob expansion is also chronological order.
        ariadne_newest="$ariadne_candidate_base"
    done
    printf '%s\n' "$ariadne_newest"
    unset ariadne_candidate ariadne_candidate_base ariadne_candidate_stamp ariadne_newest
}
