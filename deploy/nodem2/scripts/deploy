#!/bin/sh
# Deploys one trusted revision of the Ariadne sync-server to nodem2.
#
#   deploy <40-character-commit-sha>
#
# The revision must already be reachable from the configured trusted remote ref
# (origin/main). The script validates Compose configuration, builds an immutable
# candidate image, runs migrations as a one-shot job, replaces the app, verifies
# /healthz, and rolls back to the previously deployed image on failure.
set -eu
umask 077

SCRIPT_DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=deploy/nodem2/scripts/lib-common
. "$SCRIPT_DIR/lib-common"

CANDIDATE_IMAGE=""
PREVIOUS_IMAGE=""
APP_REPLACED=0

on_exit() {
    status=$?
    if [ "$status" -ne 0 ] && [ "$APP_REPLACED" -eq 1 ]; then
        rollback
        status=1
    fi
    exit "$status"
}

rollback() {
    if [ -z "$PREVIOUS_IMAGE" ]; then
        log "rollback skipped: no previous image was recorded"
        return 0
    fi
    log "rolling back sync-server to the previously deployed image"
    if SYNC_SERVER_IMAGE="$PREVIOUS_IMAGE" ariadne_compose up -d --no-deps sync-server; then
        log "rollback complete"
    else
        log "rollback failed; sync-server requires manual recovery"
    fi
}

[ "$#" -eq 1 ] || fail "usage: deploy <40-character-commit-sha>"
REVISION=$1
case "$REVISION" in
    *[!0-9a-f]* | "") fail "revision must be a full 40-character lowercase hex commit sha" ;;
esac
[ "${#REVISION}" -eq 40 ] || fail "revision must be a full 40-character lowercase hex commit sha"

require_deployment_inputs
[ -d "$ARIADNE_WORKTREE/.git" ] || [ -f "$ARIADNE_WORKTREE/.git" ] ||
    fail "deployment worktree is missing: $ARIADNE_WORKTREE"
mkdir -p "$ARIADNE_STATE_DIR"

trap on_exit EXIT INT TERM

log "verifying revision against $ARIADNE_TRUSTED_REMOTE/$ARIADNE_TRUSTED_BRANCH"
if [ -n "$(git -C "$ARIADNE_WORKTREE" status --porcelain)" ]; then
    fail "deployment worktree is dirty; refusing to deploy modified source"
fi

# The trusted ref must be refreshed before it is trusted: deploying against a
# stale local ref would allow a revision that has since been removed from the
# trusted branch. The operator service therefore keeps the egress it needs to
# reach the git remote.
git -C "$ARIADNE_WORKTREE" fetch --quiet --no-tags "$ARIADNE_TRUSTED_REMOTE" \
    "+refs/heads/$ARIADNE_TRUSTED_BRANCH:$ARIADNE_TRUSTED_REF" ||
    fail "could not fetch $ARIADNE_TRUSTED_REF from $ARIADNE_TRUSTED_REMOTE; refusing to deploy against a stale trusted ref"

TRUSTED_TIP=$(git -C "$ARIADNE_WORKTREE" rev-parse --verify --quiet "$ARIADNE_TRUSTED_REF^{commit}") ||
    fail "trusted ref $ARIADNE_TRUSTED_REF is not available"
[ -n "$TRUSTED_TIP" ] || fail "trusted ref $ARIADNE_TRUSTED_REF is not available"

git -C "$ARIADNE_WORKTREE" cat-file -e "$REVISION^{commit}" 2>/dev/null ||
    fail "revision is not a known commit in the trusted worktree"
git -C "$ARIADNE_WORKTREE" merge-base --is-ancestor "$REVISION" "$TRUSTED_TIP" ||
    fail "revision is not reachable from the trusted ref $ARIADNE_TRUSTED_REF"

log "checking out the trusted revision in $ARIADNE_WORKTREE"
git -C "$ARIADNE_WORKTREE" checkout --detach --force "$REVISION" ||
    fail "failed to check out the trusted revision"
CHECKED_OUT=$(git -C "$ARIADNE_WORKTREE" rev-parse HEAD)
[ "$CHECKED_OUT" = "$REVISION" ] || fail "checked out revision does not match the requested revision"
if [ -n "$(git -C "$ARIADNE_WORKTREE" status --porcelain)" ]; then
    fail "deployment worktree is dirty after checkout; refusing to deploy"
fi

CANDIDATE_IMAGE="$ARIADNE_IMAGE_REPO:$REVISION"

PREVIOUS_IMAGE=$(docker image inspect --format '{{.Id}}' "$ARIADNE_CURRENT_TAG" 2>/dev/null || true)
if [ -n "$PREVIOUS_IMAGE" ]; then
    printf '%s\n' "$PREVIOUS_IMAGE" >"$ARIADNE_STATE_DIR/rollback-image"
    chmod 600 "$ARIADNE_STATE_DIR/rollback-image"
    log "recorded rollback image target"
else
    log "no previous image is tagged $ARIADNE_CURRENT_TAG; rollback will be unavailable"
fi

log "validating Compose configuration"
SYNC_SERVER_IMAGE="$CANDIDATE_IMAGE" ariadne_compose config --quiet ||
    fail "Compose configuration is invalid"

log "building candidate image for revision $REVISION"
SYNC_SERVER_IMAGE="$CANDIDATE_IMAGE" ariadne_compose build sync-server ||
    fail "candidate image build failed"

log "starting database"
SYNC_SERVER_IMAGE="$CANDIDATE_IMAGE" ariadne_compose up -d --wait postgres ||
    fail "postgres failed to become healthy"

log "running migrations"
SYNC_SERVER_IMAGE="$CANDIDATE_IMAGE" ariadne_compose run --rm --no-deps migrate ||
    fail "migrations failed; app was not replaced"

log "starting candidate sync-server"
APP_REPLACED=1
SYNC_SERVER_IMAGE="$CANDIDATE_IMAGE" ariadne_compose up -d --no-deps sync-server ||
    fail "candidate sync-server failed to start"

log "verifying health endpoint"
attempt=1
healthy=0
while [ "$attempt" -le "$ARIADNE_HEALTH_ATTEMPTS" ]; do
    if curl -fsS --max-time 5 -o /dev/null "$ARIADNE_HEALTH_URL"; then
        healthy=1
        break
    fi
    attempt=$((attempt + 1))
    if [ "$ARIADNE_HEALTH_INTERVAL" -gt 0 ]; then
        sleep "$ARIADNE_HEALTH_INTERVAL"
    fi
done

if [ "$healthy" -ne 1 ]; then
    if [ -z "$PREVIOUS_IMAGE" ]; then
        APP_REPLACED=0
        fail "health verification failed and no previous image is available for rollback"
    fi
    fail "health verification failed; starting rollback"
fi

APP_REPLACED=0
docker tag "$CANDIDATE_IMAGE" "$ARIADNE_CURRENT_TAG" ||
    fail "failed to update the $ARIADNE_CURRENT_TAG rollback pointer"
log "deployment of revision $REVISION succeeded"
